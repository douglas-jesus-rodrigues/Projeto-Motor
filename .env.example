# =========================================
# AMBIENTE
# =========================================

NODE_ENV=development
PORT=4000

# Endereço público do site
PROD=http://localhost:4000

# Origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:4000,http://localhost:3000

# =========================================
# BANCO MYSQL
# =========================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque-a-senha-no-arquivo-env
DB_NAME=motorflex

DB_CONNECTION_LIMIT=10

# Ative somente se o provedor exigir SSL
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# =========================================
# AUTENTICAÇÃO
# =========================================

JWT_SECRET=coloque-um-segredo-longo-no-arquivo-env
SESSION_SECRET=coloque-outro-segredo-longo-no-arquivo-env

# =========================================
# RESEND
# =========================================

# =========================================
# RESEND
# =========================================

RESEND_API_KEY=coloque-a-chave-no-arquivo-env

# Durante testes:
EMAIL_FROM=MotorFlex <onboarding@resend.dev>

# Depois de verificar seu domínio:
# EMAIL_FROM=MotorFlex <contato@seu-dominio.com>